# LF everywhere so generated files (tauri-specta bindings, snapshots) never drift by line ending.
* text=auto eol=lf

# Windows scripts keep CRLF (PowerShell/cmd are happier with it).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.woff2 binary
*.msix binary
*.exe binary

# Generated files: collapse in diffs, still reviewed by CODEOWNERS.
packages/contracts/src/bindings.ts linguist-generated=true
pnpm-lock.yaml linguist-generated=true
apps/desktop/src-tauri/Cargo.lock linguist-generated=true
