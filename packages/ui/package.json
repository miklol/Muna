{
  "name": "@muna/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Muna design system: tokens, primitives, motion presets, icons",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./theme.css": "./src/tokens/theme.css",
    "./fonts.css": "./src/tokens/fonts.css",
    "./tokens": "./src/tokens/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./motion": "./src/motion/index.ts",
    "./shape": "./src/shape/index.ts",
    "./storybook": "./src/storybook/preview.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --quiet",
    "test-storybook": "test-storybook"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-playwright": "^2.2.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "figma-squircle": "^1.1.0",
    "motion": "^13.4.6",
    "react-aria-components": "^1.21.1"
  }
}
